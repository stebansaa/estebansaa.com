---
// Decorative WebGL background for the hero. The content around it is plain HTML,
// so the page is fully readable and indexable before (or without) this loading.
---

<div class="hero-scene" aria-hidden="true">
  <canvas data-hero-canvas></canvas>
</div>

<script>
  function shouldSkip3D(): boolean {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return true;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return true;
    try {
      const c = document.createElement('canvas');
      return !(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return true;
    }
  }

  function boot() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!canvas || canvas.dataset.started || shouldSkip3D()) return;
    canvas.dataset.started = '1';
    // Three.js is only downloaded here, after the page is interactive.
    import('../scripts/hero-scene').then(({ startHeroScene }) => startHeroScene(canvas));
  }

  const schedule = (fn: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 200);

  // Runs on first load and after every client-side navigation.
  document.addEventListener('astro:page-load', () => schedule(boot));
</script>

<style>
  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Static fallback shown until (or instead of) WebGL. */
    background:
      radial-gradient(40rem 30rem at 70% 40%, color-mix(in oklab, var(--accent-2) 35%, transparent), transparent 70%),
      radial-gradient(30rem 24rem at 30% 70%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  canvas:global([data-ready]) {
    opacity: 1;
  }
</style>
